# Copiar a .env y ajustar. El .env real no se versiona.

# --- Servicio ---
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
INSTANCE_ID=products-service-1

# --- Base de datos propia del servicio (requerimiento 3: BD por servicio) ---
# products-service NUNCA apunta al Postgres de auth-service.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=products
DB_PASSWORD=products
DB_NAME=productsdb
DB_LOGGING=false

# --- Timeouts servicio -> BD (requerimiento 6), en milisegundos ---
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
