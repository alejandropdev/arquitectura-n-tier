# Copie este archivo a `.env` antes de levantar el despliegue:  cp .env.example .env

# --- Tier 3: base de datos ---
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=authdb

# --- Tier 2: microservicio ---
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-larga
JWT_EXPIRATION_MINUTES=30
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=300

# --- Tier 1: web (tácticas de disponibilidad del cliente) ---
AUTH_TIMEOUT_SECONDS=3
RETRY_ATTEMPTS=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=15

# --- Observabilidad ---
LOG_LEVEL=INFO
